// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  role          UserRole  @default(CLINICIAN)
  passwordHash  String
  patientId     String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  patient       Patient?  @relation(fields: [patientId], references: [id])
  instrumentAssignments InstrumentAssignment[]
  auditLogs     AuditLog[]

  @@map("users")
}

model Patient {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  dateOfBirth DateTime
  referralSource String?
  status      PatientStatus @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  evaluations Evaluation[]
  user        User?
  instrumentSessions InstrumentSession[]
  instrumentAssignments InstrumentAssignment[]
  
  @@map("patients")
}

model Assessment {
  id          String @id @default(cuid())
  name        String
  domain      AssessmentDomain
  platform    AssessmentPlatform
  minAge      Int
  maxAge      Int
  description String?
  
  evaluationAssessments EvaluationAssessment[]
  subtests              Subtest[]
  evaluations           Evaluation[]
  
  @@map("assessments")
}

model Evaluation {
  id                String   @id @default(cuid())
  patientId         String
  assessmentId      String
  status            EvaluationStatus @default(IN_PROGRESS)
  administeredDate  DateTime?
  administeredBy    String?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  patient           Patient @relation(fields: [patientId], references: [id])
  assessment        Assessment @relation(fields: [assessmentId], references: [id])
  scores            Score[]
  report            Report?
  evaluationAssessments EvaluationAssessment[]
  
  @@map("evaluations")
}

model EvaluationAssessment {
  id           String @id @default(cuid())
  evaluationId String
  assessmentId String
  
  evaluation Evaluation @relation(fields: [evaluationId], references: [id])
  assessment Assessment @relation(fields: [assessmentId], references: [id])
  
  @@map("evaluation_assessments")
}

model Subtest {
  id          String @id @default(cuid())
  assessmentId String
  name        String
  index       String?
  rawScore    Int?
  scaledScore Int?
  
  assessment  Assessment @relation(fields: [assessmentId], references: [id])
  scores      Score[]
  
  @@map("subtests")
}

model Score {
  id           String @id @default(cuid())
  evaluationId String
  subtestId    String
  rawScore     Int?
  scaledScore  Int?
  percentile   Float?
  
  evaluation   Evaluation @relation(fields: [evaluationId], references: [id])
  subtest      Subtest @relation(fields: [subtestId], references: [id])
  
  @@map("scores")
}

model Report {
  id                    String @id @default(cuid())
  evaluationId          String @unique
  diagnosticImpressions DiagnosticImpression[]
  narrativeSections     NarrativeSection[]
  recommendations       Recommendation[]
  
  evaluation            Evaluation @relation(fields: [evaluationId], references: [id])
  
  signatureName         String?
  signatureTitle        String?
  signedAt              DateTime?
  
  @@map("reports")
}

model DiagnosticImpression {
  id          String @id @default(cuid())
  reportId    String
  dsm5Code    String?
  icd11Code   String?
  severity    Severity
  evidence    String?
  
  report      Report @relation(fields: [reportId], references: [id])
  
  @@map("diagnostic_impressions")
}

model NarrativeSection {
  id      String @id @default(cuid())
  reportId String
  section NarrativeSectionType
  content String
  
  report  Report @relation(fields: [reportId], references: [id])
  
  @@unique([reportId, section])
  @@map("narrative_sections")
}

model Recommendation {
  id            String @id @default(cuid())
  reportId      String
  category      RecommendationCategory
  description   String
  priority      Priority @default(MEDIUM)
  
  report        Report @relation(fields: [reportId], references: [id])
  
  @@map("recommendations")
}

model Instrument {
  id          String           @id @default(cuid())
  slug        String           @unique
  name        String
  description String?
  minAgeYears Int?
  maxAgeYears Int?
  audience    InstrumentAudience @default(PATIENT)
  status      InstrumentStatus @default(ACTIVE)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  items       InstrumentItem[]
  sessions    InstrumentSession[]
  assignments InstrumentAssignment[]

  @@map("instruments")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  details   Json?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model InstrumentAssignment {
  id              String                     @id @default(cuid())
  patientId       String
  instrumentId    String
  assignedByUserId String?
  status          InstrumentAssignmentStatus @default(ASSIGNED)
  dueDate          DateTime?
  token           String?                    @unique
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  patient         Patient                    @relation(fields: [patientId], references: [id])
  instrument      Instrument                 @relation(fields: [instrumentId], references: [id])
  assignedByUser  User?                      @relation(fields: [assignedByUserId], references: [id])

  @@unique([patientId, instrumentId])
  @@map("instrument_assignments")
}

model InstrumentItem {
  id           String      @id @default(cuid())
  instrumentId String
  order        Int
  prompt       String
  options      Json

  instrument   Instrument  @relation(fields: [instrumentId], references: [id])
  responses    InstrumentResponse[]

  @@unique([instrumentId, order])
  @@map("instrument_items")
}

model InstrumentSession {
  id           String                 @id @default(cuid())
  instrumentId String
  patientId    String
  status       InstrumentSessionStatus @default(IN_PROGRESS)
  startedAt    DateTime               @default(now())
  submittedAt  DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  instrument   Instrument             @relation(fields: [instrumentId], references: [id])
  patient      Patient                @relation(fields: [patientId], references: [id])
  responses    InstrumentResponse[]
  result       InstrumentResult?

  @@map("instrument_sessions")
}

model InstrumentResponse {
  id        String            @id @default(cuid())
  sessionId String
  itemId    String
  value     Int

  session   InstrumentSession @relation(fields: [sessionId], references: [id])
  item      InstrumentItem    @relation(fields: [itemId], references: [id])

  @@unique([sessionId, itemId])
  @@map("instrument_responses")
}

model InstrumentResult {
  id             String            @id @default(cuid())
  sessionId       String            @unique
  totalScore      Int
  interpretation  String
  details         Json?
  createdAt       DateTime          @default(now())

  session         InstrumentSession @relation(fields: [sessionId], references: [id])

  @@map("instrument_results")
}

enum PatientStatus {
  ACTIVE
  INACTIVE
  DISCHARGED
}

enum AssessmentDomain {
  COGNITIVE
  ADAPTIVE
  BEHAVIORAL
  EXECUTIVE_FUNCTION
  ACADEMIC
  EMOTIONAL
  SOCIAL
}

enum AssessmentPlatform {
  Q_INTERACTIVE
  Q_GLOBAL
  MHS_ONLINE
  ALTO
}

enum EvaluationStatus {
  IN_PROGRESS
  COMPLETED
  PENDING_REVIEW
  APPROVED
}

enum Severity {
  NONE
  MILD
  MODERATE
  SEVERE
}

enum NarrativeSectionType {
  REFERRAL
  BACKGROUND
  OBSERVATIONS
  FINDINGS
  SUMMARY
}

enum RecommendationCategory {
  ACADEMIC_ACCOMMODATIONS
  THERAPY
  EDUCATIONAL_PLANNING
  RE_EVALUATION
  PARENTAL_SUPPORT
  MEDICAL_REFERRAL
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum InstrumentStatus {
  ACTIVE
  INACTIVE
}

enum InstrumentAudience {
  PATIENT
  PARENT
  TEACHER
}

enum InstrumentAssignmentStatus {
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

enum InstrumentSessionStatus {
  IN_PROGRESS
  SUBMITTED
}

enum UserRole {
  ADMIN
  CLINICIAN
  STAFF
  PATIENT
}
